{
  "bin": {
    "pack": "./index.mjs"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "pug": "^3.0.4",
    "sass": "^1.106.1",
    "yargs": "^18.2.0"
  },
  "scripts": {
    "test": "node index.mjs --from=test/from --to=test/to",
    "test-minify": "node index.mjs --from=test/from --minify --to=test/to",
    "test-minify-with-modules": "node index.mjs --from=test/from --minify --mjs --pug --scss --to=test/to",
    "test-with-modules": "node index.mjs --from=test/from --mjs --pug --scss --to=test/to",
    "test-wrap": "node index.mjs --css-enter='%(css.license)' --from=test/from --html-enter='%(html.license)' --js-enter='%(js.license)' --mjs-enter='%(mjs.license)' --pug-enter='%(pug.license)' --scss-enter='%(scss.license)' --to=test/to"
  },
  "type": "module"
}